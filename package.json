{
  "name": "reverse-mcp-tools",
  "version": "0.2.2",
  "description": "One-click installer for reverse-engineering MCP servers (Ghidra, JADX, x64dbg, jshook/Frida) into your MCP clients.",
  "type": "module",
  "bin": {
    "reverse-mcp-tools": "dist/index.js",
    "remcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm run test",
    "verify:write": "npm run build && node scripts/verify-write.mjs",
    "verify:assets": "npm run build && node scripts/verify-assets.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "reverse-engineering",
    "ghidra",
    "jadx",
    "x64dbg",
    "frida",
    "installer"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.2.1",
    "commander": "^13.0.0",
    "extract-zip": "^2.0.1",
    "picocolors": "^1.1.1",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  }
}
